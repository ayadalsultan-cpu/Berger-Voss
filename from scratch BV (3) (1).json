    {
      "parameters": {
        "jsCode": "// Output Guardrails replaces the item with { guardrailsInput, checks } on\n// its Pass branch and does not forward the classification/confidence\n// fields. This node recovers them from guardrailsInput (which n8n's\n// Guardrails node does preserve) so the final response has real data.\n\nconst input = $input.first().json.guardrailsInput;\n\n// guardrailsInput is the exact string we sent in: \n// \"Classification decision for a Berger & Voss recruitment application: X (confidence Y)\"\nconst match = String(input).match(/application:\\s*(\\w+)\\s*\\(confidence\\s*([\\d.]+)\\)/);\n\nreturn [{\n  json: {\n    classification: match ? match[1] : null,\n    confidence: match ? parseFloat(match[2]) : null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        -144
      ],
