    {
      "parameters": {
        "jsCode": "// The Agent node's native output field ($json.output) is a STRING —\n// possibly with the JSON classification wrapped inside it, sometimes\n// with stray whitespace or markdown fences even when the prompt asks\n// for neither. This node parses it into flat, usable fields so every\n// downstream node (Output Guardrails, the final Output node) can\n// reference $json.classification / $json.confidence / $json.reasoning\n// directly instead of guessing at a raw string's shape.\n\nconst raw = $input.first().json.output;\n\nlet parsed;\ntry {\n  // Strip markdown code fences if the model added them despite instructions\n  const cleaned = String(raw).trim().replace(/^```json\\s*/i, '').replace(/```$/, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (err) {\n  // If parsing fails, surface it as a structural problem rather than\n  // silently passing blank fields forward.\n  parsed = {\n    classification: '',\n    confidence: null,\n    reasoning: '',\n    parse_error: true,\n    raw_output: raw\n  };\n}\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    classification: parsed.classification,\n    confidence: parsed.confidence,\n    reasoning: parsed.reasoning || '',\n    parse_error: parsed.parse_error || false,\n    raw_output: parsed.raw_output\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        144
      ],
      "id": "49f17a00-dd2a-4a62-bfa5-3fc1bc194e10",
      "name": "Parse Agent Output"
    },
    {
      "parameters": {
        "text": "=Classification decision for a Berger & Voss recruitment application: {{ $json.classification }} (confidence {{ $json.confidence }})",
        "guardrails": {
          "topicalAlignment": {
            "value": {
              "threshold": 0.7,
              "prompt": "You are a content analysis system that determines if text stays on topic.\n\nBUSINESS SCOPE:\"This agent classifies recruitment applications by role fit, urgency, and missing information, and drafts next-step messages. It does not provide visa or immigration guidance, salary negotiation advice, or legal advice. Any content matching those topics should be flagged as out of scope.\"\n\n\nDetermine if the text stays within the defined business scope. Flag any content\nthat strays from the allowed topics."
            }
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.guardrails",
      "typeVersion": 2,
      "position": [
        1600,
        -112
      ],
      "id": "1c9df79a-9e89-44ea-b389-af0e72cc8b0c",
      "name": "Output Guardrails"
