    {
      "parameters": {
        "promptType": "define",
        "text": "=$('Normalize Application Fields').item.json.candidate_name / .application_notes{{ $('Normalize Application Fields').item.json.candidate_name }}\n{{ $('Normalize Application Fields').item.json.application_notes }}",
        "options": {
          "systemMessage": "=You are the intake classification agent for Berger & Voss Talent Group, a recruitment agency with offices in Munich and Cluj-Napoca.\n\nRead one candidate application and produce a structured classification.\n\nOutput strictly as JSON:\n{\n  \"classification\": \"advance\" | \"request_info\" | \"decline\",\n  \"confidence\": <number between 0 and 1>\n}\n\nReturn only the JSON object. No markdown fences, no commentary.\n\nif the input raises a topic outside its defined scope. It should classify the application normally but flag the out-of-scope content as a note for a human reviewer, rather than generating any advice.",
          "maxIterations": 3
        }
      },
      "id": "889e7113-7ffc-477a-8748-f740a8893786",
      "name": "Intake Classification Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        800,
        32
      ],
      "notes": "No guardrails, no tool tiering, no Max Iterations cap yet — this is the pre-Sprint-1 baseline. Sublesson 2.1 adds all of that on top of this file."
    },
